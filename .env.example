# MacroPulse Configuration

# Environment mode ('development', 'production')
ENV=development

# Federal Reserve Economic Data (FRED) API Key (Optional)
# Leave blank to run automatically on bundled verified demo fixtures with is_demo = true.
# Request a free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Database Connection (SQLite for local zero-config, PostgreSQL for production Docker)
DATABASE_URL=sqlite:///./macropulse.db
# DATABASE_URL=postgresql://macropulse:macropulse_secure_password@localhost:5432/macropulse

# Server Debug Flag
DEBUG=false
